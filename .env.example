# =============================================================================
# RentHub — пример переменных окружения
# =============================================================================
# Скопируйте этот файл в .env (для разработки) или .env.production (для prod).
# В production все секреты должны приходить из secret manager / переменных
# окружения хостинга, а НЕ из файла на диске.
# =============================================================================

# ----------------------- Backend -----------------------
DATABASE_URL="postgresql://renthub:renthub@localhost:5433/renthub?schema=public"
REDIS_URL="redis://localhost:6380"
PORT=3001
NODE_ENV=development
LOG_LEVEL=debug                          # debug|info|warn|error

# ----------------------- Auth --------------------------
# Сгенерировать сильные секреты:
#   openssl rand -base64 64
JWT_ACCESS_SECRET="change-me-in-production-access"
JWT_REFRESH_SECRET="change-me-in-production-refresh"
JWT_ACCESS_TTL=900                       # 15 минут (секунды)
JWT_REFRESH_TTL=604800                   # 7 дней   (секунды)

# ----------------------- Шифрование секретов at-rest --
# Ключ для AES-256-GCM шифрования секретов в БД (SMTP-пароль и т.п.).
# Сгенерировать (32 байта в base64):
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Если не задан — в dev производится из JWT_ACCESS_SECRET (НЕ для прода!).
# В production ОБЯЗАТЕЛЬНО задавать отдельным значением.
# SECRET_ENCRYPTION_KEY="<base64-32-байта>"

# ----------------------- CORS --------------------------
WEB_URL="http://localhost:5173"

# ----------------------- Cookies -----------------------
COOKIE_SECURE=false                      # true в production (требует HTTPS)
COOKIE_DOMAIN=                           # например, .renthub.example.com

# ----------------------- Загрузки ----------------------
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=5242880                  # 5 MB

# ----------------------- Категории ---------------------
# Максимальная глубина дерева категорий. Допустимый диапазон: 1..6.
# Дефолт 4 покрывает большинство rental-бизнесов (Раздел → Группа → Тип → Подтип).
# Меньше — дерево примитивнее, проще для клиента. Больше — гибче для нишевых таксономий.
CATEGORY_MAX_DEPTH=4

# ----------------------- Сидер (только для dev) --------
SEED_ADMIN_EMAIL="admin@renthub.com"
SEED_ADMIN_PASSWORD="admin"
SEED_ADMIN_FIRST_NAME="Admin"
SEED_ADMIN_LAST_NAME="User"

# ----------------------- Frontend (Vite) ---------------
VITE_API_URL="http://localhost:3001"

# =============================================================================
# Production-only переменные (раскомментировать и заполнить при деплое)
# =============================================================================

# Sentry — мониторинг ошибок и производительности
# SENTRY_DSN=https://...@o12345.ingest.sentry.io/67890
# SENTRY_RELEASE=renthub-api@1.0.0
# SENTRY_TRACES_SAMPLE_RATE=0.1

# Защита Swagger UI в продакшене (Basic Auth)
# Если оба параметра не заданы — Swagger полностью отключён в production.
# SWAGGER_USER=docs
# SWAGGER_PASSWORD=<сильный пароль>

# Реквизиты PostgreSQL и Redis для compose.prod.yml (если используете)
# POSTGRES_USER=renthub
# POSTGRES_PASSWORD=<сильный пароль>
# POSTGRES_DB=renthub
# REDIS_PASSWORD=<сильный пароль>
# WEB_PORT=8080
